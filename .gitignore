# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Runtime data -- generated by the app, shouldn't be committed
webapp/uploads/*
!webapp/uploads/.gitkeep
webapp/converted/*
!webapp/converted/.gitkeep
inbox/*
!inbox/.gitkeep
outbox/*
!outbox/.gitkeep
processed/*
!processed/.gitkeep
failed/*
!failed/.gitkeep

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
